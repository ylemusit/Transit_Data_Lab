{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transit-data-lab:audit-interpretation-contract:v1",
  "title": "Audit Interpretation Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "interpretation_status", "dataset_identity", "execution_identity", "source_findings", "finding_families", "coverage", "limitations", "provenance"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "interpretation_status": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "dataset_identity": {"$ref": "#/$defs/datasetIdentity"},
    "execution_identity": {"$ref": "#/$defs/executionIdentity"},
    "source_findings": {"type": "array", "items": {"$ref": "#/$defs/sourceFinding"}},
    "finding_families": {"type": "array", "items": {"$ref": "#/$defs/findingFamily"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "datasetIdentity": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "sha256"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
    "executionIdentity": {"type": "object", "additionalProperties": false, "required": ["audit_execution_id", "engine_version", "interpretation_version"], "properties": {"audit_execution_id": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1}, "interpretation_version": {"const": "1.0.0"}}},
    "sourceFinding": {"type": "object", "additionalProperties": true, "required": ["raw_finding_id", "rule_id", "stage", "source_file", "technical_status", "entity_type", "entity_id"], "properties": {"raw_finding_id": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1}, "stage": {"type": "string", "minLength": 1}, "source_file": {"type": "string", "minLength": 1}, "technical_status": {"type": "string", "minLength": 1}, "entity_type": {"$ref": "#/$defs/entityType"}, "entity_id": {"type": "string", "minLength": 1}, "row_reference": {"type": ["string", "integer"]}, "observed_values": {"type": "object"}}},
    "entityType": {"enum": ["agency", "route", "trip", "service", "stop", "shape", "stop_time", "calendar", "calendar_date", "frequency", "feed"]},
    "epistemicStatement": {"type": "object", "additionalProperties": false, "required": ["kind", "statement"], "properties": {"kind": {"enum": ["OBSERVED", "CALCULATED", "INFERRED", "NOT_EVALUABLE"]}, "statement": {"type": "string", "minLength": 1}, "basis_refs": {"type": "array", "items": {"type": "string"}}}},
    "population": {"type": "object", "additionalProperties": false, "required": ["population_type", "population_count"], "properties": {"population_type": {"$ref": "#/$defs/entityType"}, "population_count": {"type": ["integer", "null"], "minimum": 0}}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["direct_affected", "propagated_usage"], "properties": {"direct_affected": {"type": "object", "additionalProperties": false, "required": ["entity_type", "entity_count"], "properties": {"entity_type": {"$ref": "#/$defs/entityType"}, "entity_count": {"type": ["integer", "null"], "minimum": 0}}}, "propagated_usage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["entity_type", "entity_count"], "properties": {"entity_type": {"$ref": "#/$defs/entityType"}, "entity_count": {"type": ["integer", "null"], "minimum": 0}}}}}},
    "pattern": {"type": "object", "additionalProperties": false, "required": ["pattern_id", "status", "occurrence_count", "classification"], "properties": {"pattern_id": {"type": "string", "minLength": 1}, "status": {"enum": ["CONFIRMED_PATTERN", "COMPATIBLE_PATTERN", "MIXED_PATTERN", "UNKNOWN_PATTERN", "NOT_EVALUABLE"]}, "occurrence_count": {"type": "integer", "minimum": 0}, "classification": {"type": "string", "minLength": 1}}},
    "findingFamily": {"type": "object", "additionalProperties": false, "required": ["family_id", "rule_id", "stage", "source_file", "technical_status", "raw_occurrence_count", "affected_entity_type", "affected_entity_count", "population", "affected_percentage", "observations", "calculations", "inferences", "patterns", "unclassified_occurrences", "operational_impact", "probable_explanations", "confidence_basis", "remediation_assessment", "evidence_refs", "limitations"], "properties": {"family_id": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1}, "stage": {"type": "string", "minLength": 1}, "source_file": {"type": "string", "minLength": 1}, "technical_status": {"type": "string", "minLength": 1}, "raw_occurrence_count": {"type": "integer", "minimum": 0}, "affected_entity_type": {"$ref": "#/$defs/entityType"}, "affected_entity_count": {"type": ["integer", "null"], "minimum": 0}, "population": {"$ref": "#/$defs/population"}, "affected_percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "observations": {"type": "array", "items": {"$ref": "#/$defs/epistemicStatement"}}, "calculations": {"type": "array", "items": {"$ref": "#/$defs/epistemicStatement"}}, "inferences": {"type": "array", "items": {"$ref": "#/$defs/epistemicStatement"}}, "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}}, "unclassified_occurrences": {"type": "integer", "minimum": 0}, "operational_impact": {"$ref": "#/$defs/impact"}, "probable_explanations": {"type": "array", "items": {"$ref": "#/$defs/epistemicStatement"}}, "confidence_basis": {"type": ["string", "null"]}, "remediation_assessment": {"enum": ["SAFE_DETERMINISTIC", "HUMAN_REVIEW", "NOT_RECOMMENDED", "NOT_EVALUABLE"]}, "evidence_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["raw_finding_ids", "source_file", "dataset_sha256", "audit_execution_id"], "properties": {"raw_finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "source_file": {"type": "string", "minLength": 1}, "row_entity_refs": {"type": "object"}, "dataset_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "audit_execution_id": {"type": "string", "minLength": 1}}}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["raw_finding_count", "consolidated_occurrence_count", "unclassified_occurrence_count", "accounting_gap"], "properties": {"raw_finding_count": {"type": "integer", "minimum": 0}, "consolidated_occurrence_count": {"type": "integer", "minimum": 0}, "unclassified_occurrence_count": {"type": "integer", "minimum": 0}, "accounting_gap": {"type": "integer"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["schema_version", "deterministic_family_id_basis", "raw_findings_immutable"], "properties": {"schema_version": {"const": "1.0.0"}, "deterministic_family_id_basis": {"type": "string", "minLength": 1}, "raw_findings_immutable": {"const": true}}}
  }
}
