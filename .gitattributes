# Transit Data Lab: repository EOL policy, independent of core.autocrlf.
# Normal text: LF in Git and checkout; no inherited content filters.
* text=auto eol=lf -filter -ident -working-tree-encoding
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
*.canvas text eol=lf

